PORT=5050

# OpenAI (optional). Leave OPENAI_API_KEY blank to always use the local LLM.
# If set, OpenAI is tried first and the server falls back to the local LLM on failure.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Local LLM fallback (Ollama, OpenAI-compatible at /v1).
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3
LOCAL_LLM_TIMEOUT_MS=120000

IDEAS_API_URL=
IDEAS_API_KEY=
IDEAS_API_AUTH_HEADER=x-api-key
IDEAS_API_AUTH_SCHEME=
IDEAS_API_TIMEOUT_MS=25000
RUBRIC_GRADER_API_URL=
RUBRIC_GRADER_API_KEY=
RUBRIC_GRADER_API_AUTH_HEADER=x-api-key
RUBRIC_GRADER_API_AUTH_SCHEME=
RUBRIC_GRADER_API_TIMEOUT_MS=30000
